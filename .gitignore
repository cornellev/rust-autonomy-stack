# Whitelist .gitignore, IHMC repository-group style.
#
# Everything is ignored by default so that repositories cloned into this one by
# `gitman` (into repos/, linked into nodes/) are invisible to git operations run
# here. Nesting git repos is normally a bad idea; the whitelist is what makes it
# safe. Add an explicit `!` line for anything that genuinely belongs to the
# group repo.
*

!.gitignore
!README.md
!RUNNING.md

# Cargo workspace glue
!Cargo.toml
!Cargo.lock
!.cargo
!.cargo/*

# Dependency manifest (sources + locked revisions live in this one file)
!gitman.yml

# Recursive git helpers
!.tools
!.tools/*

# First-party, in-tree code
!crates
!crates/**
!cars
!cars/**

# Car-agnostic sensor catalog: one file per sensor model the team owns.
!sensors
!sensors/**

!.github
!.github/workflows
!.github/workflows/*

# The workspace globs over nodes/*, and Cargo treats the glob as a literal path
# when the directory is missing -- so a fresh clone must have nodes/ before
# `gitman install` fills it. Track the directory, ignore its contents.
!nodes
nodes/*
!nodes/.gitkeep

# ...but never build output, even under a whitelisted directory.
target/
**/*.rs.bk
