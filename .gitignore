# Whitelist .gitignore: everything is ignored unless explicitly listed below, so
# stray build output and local files never get committed by accident. Add an
# explicit `!` line for anything that genuinely belongs to this repository.
*

!.gitignore
!README.md
!RUNNING.md

# Cargo workspace glue
!Cargo.toml
!Cargo.lock
!.cargo
!.cargo/*

# First-party, in-tree code
!crates
!crates/**
!cars
!cars/**

!.github
!.github/workflows
!.github/workflows/*

# ...but never build output, even under a whitelisted directory.
target/
**/*.rs.bk
